<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrls="clr-namespace:Heimdallr.ToolKit.UI.Controls;assembly=Heimdallr.ToolKit"
    xmlns:views="clr-namespace:Heimdallr.App"
    xmlns:conve="clr-namespace:Heimdallr.ToolKit.Converters;assembly=Heimdallr.ToolKit">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Heimdallr.ToolKit;component/Themes/Controls/Colors/Color.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <conve:InverseBooleanConverter x:Key="InverseBooleanConverter" />

  <Style TargetType="{x:Type views:MainWindow}"
          BasedOn="{StaticResource {x:Type ctrls:DarkThemeWindow}}">

    <Setter Property="Content">
      <Setter.Value>

        <Border Background="Transparent" Padding="20">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>

            <ctrls:HeimdallrTreeView Grid.Row="1" Width="Auto">
              <ctrls:HeimdallrTreeViewItem PathIcon="Barcode"
                               ExpandIcon="ChevronDownEllipse"
                               CollapseIcon="ChevronUpEllipse"
                               ExpandIconFill="Yellow"
                               CollapseIconFill="CornflowerBlue"
                               IconWidth="40" IconHeight="40"
                               PathIconFill="Black"
                               ExpandToggleIconHeight="20"
                               ExpandToggleIconWidth="20"
                               SelectedBackground="AliceBlue"
                        
                                
                               FontSize="10" Foreground="Red">

                <ctrls:HeimdallrTreeViewItem Text="네트워크 등록" PathIcon="Barcode"
                  ExpandIcon="ChevronDownEllipse"
                  CollapseIcon="ChevronUpEllipse"
                  IconWidth="30" IconHeight="30"
                  ExpandIconFill="AliceBlue"
                  CollapseIconFill="Bisque"
                  FontSize="30" Foreground="AliceBlue"
                  SelectedCommand="{Binding TestTreeViewCommand}"
                                             CommandParameter="없음">

                  <ctrls:HeimdallrTreeViewItem Text="네트워크 세부정보" PathIcon="Barcode"                             
                  IconWidth="20" IconHeight="20"
                  PathIconFill="AliceBlue"
                  FontSize="20" Foreground="Green"/>

                </ctrls:HeimdallrTreeViewItem>
              </ctrls:HeimdallrTreeViewItem>
              <ctrls:HeimdallrThumb />
            </ctrls:HeimdallrTreeView>

            <TreeView Grid.Row="2" >
              <TreeViewItem>
                <TextBlock Text="OK" />
                <TextBlock Text="good" />
                <TextBlock Text="cancel" />
              </TreeViewItem>
            </TreeView>


            <ctrls:HeimdallrSwitchCheckBox Grid.Row="8" 
                                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                            Content="스위치 체크박스"
                                            Width="80" 
                                            Fill="Blue"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Foreground="White"
                                            PathIcon="Menu"
                                             />

            <ctrls:HeimdallrFlatButton
                  Grid.Row="9"
                  x:Name="LoginButton"
                  Width="150"
                  Margin="0,50,0,0"
                  Background="#FF6EACDA"
                  Command="{Binding LoginCommand}"
                  Content="LOGIN"
                  CornerRadius="7"
                  Foreground="White"
                  DisabledBackground="#FFB9B4C7"
                  DisabledBorderBrush="#FFB9B4C7"
                  DisabledForeground="DarkGray"
                  MouseOverBackground="#FF03346E"
                  MouseOverBorderBrush="#FF07346E"
                  PressedBackground="#FFC147E9"
                  PressedBorderBrush="#FFC747E9" />
            
            <Grid Grid.Row="11" Margin="0 10 0 0">
              <StackPanel Margin="10">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Margin="0 0 0 10" />

                <Button Content="사용자 불러오기"
                    Command="{Binding LoadUsersCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                
                <!-- IsEnabled="{Binding IsBusy}" 삭제 -->
                <!-- ViewModel과 View 연결 (ViewModelLocator 또는 Region 등록 시) -->
                <ctrls:LoadingOverlay
                    IsLoading="{Binding IsBusy}"
                    LoadingText="{Binding BusyMessage}"
                    IndicatorType="Cupertino"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0 10 0 0" />

                <ctrls:HeimdallrListView ItemsSource="{Binding People}"
                                         Margin="0 10 0 0"
                                         SelectedBackground="red"
                                         SelectionMode="Single">
                  <ctrls:HeimdallrListView.View>
                    <GridView>
                      <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="60"/>
                      <GridViewColumn Header="이름" DisplayMemberBinding="{Binding Name}" Width="120"/>
                      <GridViewColumn Header="나이" DisplayMemberBinding="{Binding Age}" Width="80"/>
                      <GridViewColumn Header="생일" DisplayMemberBinding="{Binding BirthDay, StringFormat='yyyy-MM-dd'}" Width="130"/>
                      <GridViewColumn Header="주소" DisplayMemberBinding="{Binding Address}" Width="200" />
                    </GridView>
                  </ctrls:HeimdallrListView.View>
                </ctrls:HeimdallrListView>
              </StackPanel>
            </Grid>

            <Button Grid.Row="12" Content="비동기"
                    Width="100" Height="30"
                    Command="{Binding LoadDataCommand}" />

            <ctrls:HeimdallrIcon Grid.Row="8" PathIcon="DetailE"  Width="100" Height="100" Fill="AliceBlue" />

            <ctrls:HeimdallrIconWaterMarkTextBox Text="우리는" Foreground="White"
                                                 FontSize="16" Width="200" TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 CaretBrush="White"
                                                 PathIcon="Address" Fill="Wheat"/>

