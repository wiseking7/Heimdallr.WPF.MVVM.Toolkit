<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrls="clr-namespace:Heimdallr.ToolKit.UI.Controls;assembly=Heimdallr.ToolKit"
    xmlns:views="clr-namespace:Heimdallr.App"
    xmlns:conve="clr-namespace:Heimdallr.ToolKit.Converters;assembly=Heimdallr.ToolKit">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Heimdallr.ToolKit;component/Themes/Controls/Colors/Color.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <conve:InverseBooleanConverter x:Key="InverseBooleanConverter" />

  <Style TargetType="{x:Type views:MainWindow}"
          BasedOn="{StaticResource {x:Type ctrls:DarkThemeWindow}}">

    <Setter Property="Content">
      <Setter.Value>

        <Border Background="Transparent" Padding="20">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>

            <Grid Grid.Row="11" Margin="0 10 0 0">
              <StackPanel Margin="10">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Margin="0 0 0 10" />

                <Button Content="사용자 불러오기"
                    Command="{Binding LoadUsersCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                
                <!-- IsEnabled="{Binding IsBusy}" 삭제 -->
                <!-- ViewModel과 View 연결 (ViewModelLocator 또는 Region 등록 시) -->
                <ctrls:LoadingOverlay
                    IsLoading="{Binding IsBusy}"
                    LoadingText="{Binding BusyMessage}"
                    IndicatorType="Cupertino"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0 10 0 0" />

                <ctrls:HeimdallrListView ItemsSource="{Binding People}"
                                         Margin="0 10 0 0"
                                         SelectedBackground="red"
                                         SelectionMode="Single">
                  <ctrls:HeimdallrListView.View>
                    <GridView>
                      <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="60"/>
                      <GridViewColumn Header="이름" DisplayMemberBinding="{Binding Name}" Width="120"/>
                      <GridViewColumn Header="나이" DisplayMemberBinding="{Binding Age}" Width="80"/>
                      <GridViewColumn Header="생일" DisplayMemberBinding="{Binding BirthDay, StringFormat='yyyy-MM-dd'}" Width="130"/>
                      <GridViewColumn Header="주소" DisplayMemberBinding="{Binding Address}" Width="200" />
                    </GridView>
                  </ctrls:HeimdallrListView.View>
                </ctrls:HeimdallrListView>
              </StackPanel>
            </Grid>

            <Button Grid.Row="12" Content="비동기"
                    Width="100" Height="30"
                    Command="{Binding LoadDataCommand}" />

          </Grid>
        </Border>

      </Setter.Value>
    </Setter>
</Style>
</ResourceDictionary>
