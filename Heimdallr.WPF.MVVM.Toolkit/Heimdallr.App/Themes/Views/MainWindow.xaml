<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrls="clr-namespace:Heimdallr.ToolKit.UI.Controls;assembly=Heimdallr.ToolKit"
    xmlns:views="clr-namespace:Heimdallr.App"
    xmlns:conve="clr-namespace:Heimdallr.ToolKit.Converters;assembly=Heimdallr.ToolKit"
    xmlns:entity="clr-namespace:Heimdallr.ToolKit.EntityTest;assembly=Heimdallr.ToolKit">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/Heimdallr.ToolKit;component/Themes/Controls/Colors/Color.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <Style x:Key="HeimdallrColumnHeaderStyle" TargetType="GridViewColumnHeader">
    <Setter Property="Background" Value="#2B2B2B"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="6,3"/>
  </Style>


  <conve:InverseBooleanConverter x:Key="InverseBooleanConverter" />

  <Style TargetType="{x:Type views:MainWindow}"
          BasedOn="{StaticResource {x:Type ctrls:DarkThemeWindow}}">

    <Setter Property="Content">
      <Setter.Value>

        <Border Background="Transparent" Padding="20">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition />
            </Grid.RowDefinitions>

            <!--#region Row 1 HeimdallrRightIconTextBox, HeimdallrIconPlaceholderTextBox, HeimdallrComboBox, HeimdallrSwitchCheckBox, PathIcon 테스트 -->
            <Grid Grid.Row="1" Margin="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <!--#region Column 0 HeimdallrRightIconTextBox-->
              <ctrls:HeimdallrRightIconTextBox Grid.Column="0"
                                               Margin="10"
                                               Placeholder="Code"
                                               CornerRadius="7"
                                               MaxLength="16"
                                               PlaceholderForeground="#FFFFFFFF"
                                               PathIcon="Unit"
                                               TextAlignment="Left"
                                               TextWrapping="Wrap"
                                               IconSize="30"
                                               IconSizeRigth="20"
                                               AcceptsReturn="False"
                                               AcceptsTab="False"
                                               CharacterCasing="Upper"
                                               Fill="#FF0F828C"
                                               Foreground="#FFFFFFFF"
                                               Background="Transparent"
                                               BorderBrush="AliceBlue"
                                               FontSize="16"
                                               RightPathIcon="Information"
                                               RightFill="#FFB12C00"
                                               RightPressedFill="#FF8CABFF"
                                               Text="{Binding NumberString, UpdateSourceTrigger=PropertyChanged, Converter={conve:BarcodeFormatConverter}}"
                                               CommandParameter="LoginView"
                                               EntityType="{x:Type entity:EntityTest}"
                                               DescriptionParameter="Buy"/>
              <!--#endregion-->
              <!--#region Column 1 HeimdallrIconPlaceholderTextBox -->
              <ctrls:HeimdallrIconPlaceholderTextBox Grid.Column="1"  
                                                     Margin="10"
                                                     BorderBrush="#FFFFFFFF"
                                                     CharacterCasing="Upper"
                                                     CornerRadius="7"
                                                     PathIcon="Account"
                                                     CaretBrush="#FFFFFFFF"
                                                     Placeholder="OK바리"
                                                     PlaceholderForeground="#FFFFFFFF"
                                                     Fill="#FF0F828C"
                                                     MouseOverBorderBrush="#FF32012F"
                                                     FocusedBorderBrush="#FF4477CE"
                                                     Foreground="#FFFFFFFF"
                                                     TextAlignment="Left"
                                                     Background="Transparent"
                                                     FontSize="16"
                                                     Text="{Binding Number, UpdateSourceTrigger=PropertyChanged, Converter={conve:NumberCommaConverter}}"/>
              <!--#endregion-->
              <!--#region Column 2 HeimdallrComboBox -->
              <ctrls:HeimdallrComboBox Grid.Column="2"
                                       Margin="10"
                                       Background="Transparent"
                                       CornerRadius="7"
                                       Height="40"
                                       IsEditable="True"
                                       BorderThickness="1"
                                       BorderBrush="#98CD00"
                                       PopupBorderThickness="0" 
                                       FontSize="16"
                                       CaretBrush="#FFFFFFFF"
                                       Foreground="#FFFFFFFF"
                                       SelectedItemForeground="Red"
                                       PathIcon="Brand"
                                       PathIconFill="#FFEAD8A4"
                                       IconSize="30"
                                       PlaceholderText="콤보박스 테스트"
                                       PlaceholderForeground="BlanchedAlmond"
                                       IconCheckedFill="#FF065084"
                                       IconMouseOverFill="#FFFF2DD1"
                                       DropDownBackground="#9929EA" 
                                       DisplayMemberPath="Value" 
                                       SelectedValuePath="Key" 
                                       IconDisabledFill="Red"
                                       ItemsSource="{Binding ComboBoxItems}"
                                       VerticalContentAlignment="Center">
                <!-- 아이템 추가 -->
              </ctrls:HeimdallrComboBox>
              <!--#endregion-->
              <!--#region Column 3 HeimdallrSwitchCheckBox-->
              <ctrls:HeimdallrSwitchCheckBox Grid.Column="3"  
                                             Margin="10"
                                             Content="스위치 체크박스"
                                             Width="80" 
                                             Fill="Blue"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Top"
                                             Foreground="White"
                                             PathIcon="Menu" />
              <!--#endregion-->
              <!--#region Column  PathIcon 테스트 -->
              <StackPanel Grid.Column="4" Orientation="Horizontal" >
                <ctrls:HeimdallrIcon PathIcon="Save" Fill="White" Width="50" Height="50" />
                <ctrls:HeimdallrIcon PathIcon="Position" Fill="White" Width="50" Height="50" Margin="20 0 0 0"/>
                <ctrls:HeimdallrIcon PathIcon="PositionA" Fill="White" Width="50" Height="50" Margin="20 0 0 0"/>
                <ctrls:HeimdallrIcon PathIcon="None"  Fill="White" Width="50" Height="50" Margin="20 0 0 0"/>
                <ctrls:HeimdallrIcon PathIcon="None" Fill="White" Width="50" Height="50" Margin="20 0 0 0"/>
                <ctrls:HeimdallrIcon PathIcon="None" Fill="White" Width="50" Height="50" Margin="20 0 0 0"/>
              </StackPanel>
              <!--#endregion-->
            </Grid>
            <!--#endregion-->

            <!--#region Row 2 FlipAnimationCard, HeimdallrHoldIconButton, HeimdallrScrollBar -->
            <Grid Grid.Row="2" Margin="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />

              </Grid.ColumnDefinitions>
              <ctrls:FlipAnimationCard Grid.Column="0" CardHeight="200" CardWidth="200" FrontCornerRadius="10"
                                       BackCornerRadius="10"
                                       FrontBackground="#FF636CCB" BackBackground="#FFA8FBD3"
                                       Image="Alps" CardTitle="멋진풍경"
                                       CardDescription="사용자 정보">

                <ctrls:FlipAnimationCard.BackContent>
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="This is the back!" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <Button Content="Click Me" Width="100" Height="30" Command="{Binding MessageCommand}"/>
                  </StackPanel>
                </ctrls:FlipAnimationCard.BackContent>
              </ctrls:FlipAnimationCard>
              <ctrls:FlipAnimationCard Grid.Column="1" CardHeight="200" CardWidth="200" FrontCornerRadius="10"
                                       BackCornerRadius="10"
                                       FrontBackground="#FF636CCB" BackBackground="#FFA8FBD3"
                                       Image="TorresDelphi" CardTitle="멋진풍경"
                                       CardDescription="사용자 정보">

                <ctrls:FlipAnimationCard.BackContent>
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="This is the back!" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <Button Content="Click Me" Width="100" Height="30" Command="{Binding MessageCommand}"/>
                  </StackPanel>
                </ctrls:FlipAnimationCard.BackContent>
              </ctrls:FlipAnimationCard>

              <StackPanel Grid.Column="2" Margin="10" Orientation="Vertical">

                <TextBlock Text="이름 입력:" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <!-- 오류 메시지 표시 -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,5,0,0" />

                <ctrls:HeimdallrHoldIconButton 
                               Width="150"
                               Margin="200 0 0 0"
                               PathIcon="Address"
                               CornerRadius="7"
                               HoldDuration="0:0:0.8"
                               PathIconFill="Aqua"
                               IconSize="30"
                               FontSize="16"
                               Background="Gray"       
                               OneHoldFill="Red"
                               MouseOverBackground="#FF4DA1A9"
                               PressedBackground="#FFB13BFF"
                               TwoHoldFill="Yellow"
                               ThreeHoldFill="Blue"
                               Foreground="#FFFFFFFF"
                               Content="Hold Me"
                               Command="{Binding SaveCommand}"/>

                <ctrls:HeimdallrIconRadioButton PathIcon="ArrowDown" IconSize="40"/>
              </StackPanel>

              <ctrls:HeimdallrScrollBar Grid.Column="3" Orientation="Vertical" Height="50"/>

            </Grid>
            <!--#endregion-->

            <!--#region Row 3 HeimdallrRepeatButton, HeimdallrNumericUpDown, HeimdallrScrollBar -->
            <Grid Grid.Row="3" Margin="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <ctrls:HeimdallrRepeatButton Grid.Column="0" PathIcon="Code" Fill="AliceBlue" Grid.Row="0" Background="Black" MouseOverBackground="BlanchedAlmond" 
                                           PressedBackground="Black" Width="50" Height="50" CornerRadius="25"/>

              <ctrls:HeimdallrNumericUpDown Grid.Column="1" DownIconFill="AliceBlue" 
                                            UpIconFill="Aqua" IconSize="30" Background="Transparent" Width="100" UpIconMouseOverFill="Bisque"
                                            UpIconPressedFill="BlanchedAlmond" DownIconPressedFill="Brown" DownIconMouseOverFill="CornflowerBlue"
                                            Foreground="#FFFFFFFF"/>
              <ctrls:HeimdallrScrollBar Grid.Column="2" Orientation="Horizontal"  />

              <Button Grid.Column="3" Content="비동기" Width="100" Height="30" Command="{Binding LoadDataCommand}" />
            </Grid>
            <!--#endregion-->

            <!--#region Row 4 ViewBox -->
            <Grid Grid.Row="4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <!--#region 뷰박스-->
              <Viewbox Grid.Column="5" Width="50" Height="50">
                <Path Fill="AliceBlue"
                      Data=""  />
              </Viewbox>
              <!--#endregion -->
            </Grid>
            <!--#endregion -->

            <!--#region Row 5 HeimdallrTreeView, HeimdallrTreeViewItem-->
            <ctrls:HeimdallrTreeView Grid.Row="5" Width="Auto" Background="Transparent">
              <ctrls:HeimdallrTreeViewItem PathIcon="Approval"
                                           ExpandIcon="Arrow_Triangle_Down"
                                           CollapseIcon="Arrow_Triangle_Up"
                                           ExpandIconFill="Yellow"
                                           CollapseIconFill="CornflowerBlue"
                                           IconSize="20"
                                           PathIconFill="Black"
                                           ExpandToggleIconSize="20"
                                           SelectedBackground="AliceBlue"                         
                                           FontSize="10" Foreground="Red">

                <ctrls:HeimdallrTreeViewItem Text="등록" PathIcon="Create"
                                             ExpandIcon="Arrow_Triangle_Down"
                                             CollapseIcon="Arrow_Triangle_Up"
                                             IconSize="20"
                                             ExpandIconFill="AliceBlue"
                                             CollapseIconFill="Bisque"
                                             SelectedCommand="{Binding TestTreeViewCommand}"
                                                                          CommandParameter="없음">

                  <ctrls:HeimdallrTreeViewItem Text="세부정보" PathIcon="Create"                             
                                               IconSize="16"
                                               PathIconFill="AliceBlue"
                                               Foreground="Green"/>

                </ctrls:HeimdallrTreeViewItem>
              </ctrls:HeimdallrTreeViewItem>
              <ctrls:HeimdallrThumb />
            </ctrls:HeimdallrTreeView>
            <!--#endregion-->

            <Grid Grid.Row="6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <ctrls:HeimdallrFlatButton Grid.Column="0" Content="Flat" />
              <ctrls:HeimdallrHoldIconButton Grid.Column="1"  Content="HoldIcon"/>
              <ctrls:HeimdallrPulseEllipse Grid.Column="2"  Content="PulseEllipse"/>
              <ctrls:HeimdallrPulseRectButton Grid.Column="3" Content="PulseRect" />
              <ctrls:HoldSubmitButton Grid.Column="4" Content="Submit" HoldDuration="0:0:1"
                                      EllipseFill="DarkGray" BgEllipseFill="Blue"
                                      Width="80" Height="80"/>
            </Grid>
            
          </Grid>
          
        </Border>
      </Setter.Value>
    </Setter>
</Style>
</ResourceDictionary>

