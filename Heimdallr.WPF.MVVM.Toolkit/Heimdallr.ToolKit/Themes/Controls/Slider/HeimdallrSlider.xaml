<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrls="clr-namespace:Heimdallr.ToolKit.UI.Controls">

   <!-- HeimdallrSlider 스타일 -->
  <Style TargetType="{x:Type ctrls:HeimdallrSlider}">
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:HeimdallrSlider}">
          <Grid Background="{TemplateBinding TrackBackground}">
            <Grid Height="4" Margin="12 0 12 0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Name="LeftColumn" Width="*" />
                <!-- Thumb -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Name="RightColumn" Width="*" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="{TemplateBinding RangeLeftFill}" />
              <Border Grid.Column="2" Background="{TemplateBinding RangeRightFill}"/>
            </Grid>

            <Track x:Name="PART_Track">
              <Track.Thumb>
                <Thumb Grid.Column="1" Width="24" Height="24" Margin="2 0">
                  <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                      <Grid>
                        <ctrls:HeimdallrIcon
                                x:Name="IconPath"
                                PathIcon="{Binding ThumbIcon, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrSlider}}"
                                Fill="{Binding ThumbFill, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrSlider}}" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="IconPath" Property="Fill"
                                  Value="{Binding ThumbHoverFill, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrSlider}}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="IconPath" Property="Fill"
                                  Value="{Binding ThumbDragFill, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrSlider}}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>