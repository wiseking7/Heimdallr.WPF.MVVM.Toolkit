<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrls="clr-namespace:Heimdallr.ToolKit.UI.Controls">

  
  <!-- HeimdallrGridViewColumnHeader 스타일 -->
  <Style x:Key="HeimdallrGridViewColumnHeaderStyle" TargetType="{x:Type ctrls:HeimdallrGridViewColumnHeader}" 
         BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
    <!-- 기본 정렬 및 외형 -->
    <Setter Property="Background" Value="#2B2B2B"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="BorderBrush" Value="#444"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:HeimdallrGridViewColumnHeader}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <!-- 헤더 텍스트 영역 -->
                <ColumnDefinition/>
                <!-- 숨김 버튼 영역 -->
                <ColumnDefinition Width="18"/>
                <!-- 정렬 아이콘 영역 -->
                <ColumnDefinition Width="18"/>
              </Grid.ColumnDefinitions>

              <!-- Header 텍스트: 기본 ContentPresenter 그대로 사용 -->
              <ContentPresenter Grid.Column="0"
                                ContentSource="Header"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>

              <!-- 열 숨김 토글 버튼 -->
              <ToggleButton x:Name="HideColumnToggle"
                            Grid.Column="1"
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0"
                            IsChecked="{Binding IsColumnHidden, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            ToolTip="열 숨기기">
                <!-- 작은모양의 X 아이콘-->
                <Path Stroke="White" StrokeThickness="1.8" Data="M 3,3 L 11,11 M 11,3 L 3,11"/>
              </ToggleButton>

              <!-- 정렬 아이콘 -->
              <Path x:Name="SortArrow"
                    Grid.Column="2"
                    Width="10"
                    Height="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="White"
                    Data="M 0,0 L 1,0.5 L 2,0 Z"
                    Visibility="Collapsed"/>

            </Grid>
          </Border>

          <!-- VisualStateManager로 정렬 화살표 제어 -->
          <ControlTemplate.Triggers>
            <!-- 오름차순 정렬 -->
            <Trigger Property="Role" Value="Padding">
              <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
            </Trigger>
            <!-- 마우스 오버 -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#334155"/>
            </Trigger>
          </ControlTemplate.Triggers>

        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>