<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:cnvts="clr-namespace:Heimdallr.ToolKit.Converters"
                  xmlns:ctrls="clr-namespace:Heimdallr.ToolKit.UI.Controls" >
  
  <cnvts:ProgressConverter x:Key="ProgressConverter" />
  <cnvts:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

  <Style TargetType="{x:Type ctrls:HeimdallrProgressBar}">
    <Setter Property="Height" Value="30"/>
    <Setter Property="Background" Value="#FFE5E5E5"/>
    <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Fill" Value="DeepSkyBlue"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:HeimdallrProgressBar}">
          <Border x:Name="MainBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="5"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">

            <Grid ClipToBounds="True" Margin="2">
              <!-- 진행률 영역 -->
              <Rectangle x:Name="PART_ProgressBar"
                         RadiusX="5" RadiusY="5"
                         Fill="{TemplateBinding Fill}"
                         HorizontalAlignment="Left"
                         SnapsToDevicePixels="True">
                <Rectangle.Width>
                  <MultiBinding Converter="{StaticResource ProgressConverter}">
                    <Binding RelativeSource="{RelativeSource Mode=TemplatedParent}" Path="ActualWidth"/>
                    <Binding RelativeSource="{RelativeSource Mode=TemplatedParent}" Path="Value"/>
                    <Binding RelativeSource="{RelativeSource Mode=TemplatedParent}" Path="Maximum"/>
                  </MultiBinding>
                </Rectangle.Width>
              </Rectangle>

              <!-- 진행률 텍스트 -->
              <TextBlock Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}%}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{TemplateBinding ProgressTextForeground}" 
                         FontWeight="Bold" IsHitTestVisible="False"
                         Visibility="{Binding ShowProgressText, RelativeSource={RelativeSource TemplatedParent},
                                      Converter={StaticResource BooleanToVisibilityConverter}}"/>

              <!-- 인디터미넌트 상태 애니메이션 -->
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="ProgressStates">
                  <VisualState x:Name="Determinate"/>
                  <VisualState x:Name="Indeterminate">
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="PART_ProgressBar"
                                        Storyboard.TargetProperty="(Canvas.Left)"
                                        From="-100" To="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Duration="0:0:2" AutoReverse="False"/>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>