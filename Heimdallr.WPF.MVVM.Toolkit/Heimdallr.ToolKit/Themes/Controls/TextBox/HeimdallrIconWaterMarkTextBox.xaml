<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrls="clr-namespace:Heimdallr.ToolKit.UI.Controls">

  <Style TargetType="{x:Type ctrls:HeimdallrIconWaterMarkTextBox}">
    <Setter Property="Foreground" Value="#000000" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:HeimdallrIconWaterMarkTextBox}">
          <Border x:Name="textBorder"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="{TemplateBinding Background}"
                  Background="{TemplateBinding Background}"
                  UseLayoutRounding="True"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
            
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <ctrls:HeimdallrIcon 
                  x:Name="PART_Icon"
                  PathIcon="{TemplateBinding PathIcon}"
                  Fill="{TemplateBinding Fill}"
                  Width="25" Height="25"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Opacity="0.8"
                  Grid.Column="0" />

              <!-- 실제 입력되는 TextBox -->
              <TextBox x:Name="PART_TextBox"
                     Grid.Column="1"
                     BorderThickness="0"
                     Background="Transparent"
                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Foreground="{TemplateBinding Foreground}"
                     CaretBrush="{TemplateBinding CaretBrush}"
                     AcceptsReturn="{TemplateBinding AcceptsReturn}"
                     TextWrapping="{TemplateBinding TextWrapping}"
                     Padding="0"
                     VerticalAlignment="Stretch"
                     HorizontalAlignment="Stretch" />

              <!-- Watermark -->
              <TextBlock
                  x:Name="Watermark"
                  Text="{TemplateBinding WaterMark}"
                  Foreground="{TemplateBinding WaterMarkForeground}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="3 0 0 0"
                  IsHitTestVisible="False"
                  Visibility="Collapsed"
                  Grid.Column="1"/>
            </Grid>
          </Border>
          
          <!-- 트리거 설정 -->
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="textBorder" Property="BorderBrush" Value="#FFFFFFFF"/>
            </Trigger>
            
            <Trigger SourceName="PART_TextBox" Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="textBorder" Property="BorderBrush" Value="#FFFF6347"/>
              <Setter TargetName="textBorder" Property="BorderThickness" Value="0.5 0.5 0.5 3"/>
              <!-- 아이콘 Fill 색상 변경 -->
              <Setter TargetName="PART_Icon" Property="Fill" 
                      Value="{Binding FocusFill, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Trigger>
            
            <!-- 워터마크 표시 -->
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Text" Value=""/>
                <Condition SourceName="PART_TextBox" Property="IsKeyboardFocused" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>