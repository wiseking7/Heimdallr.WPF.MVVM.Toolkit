<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrls="clr-namespace:Heimdallr.ToolKit.UI.Controls">

  <Style TargetType="{x:Type ctrls:HeimdallrRightIconTextBox}">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:HeimdallrRightIconTextBox}">
          <Border x:Name="textBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">

            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions>
                <!-- 아이콘 공간-->
                <ColumnDefinition Width="Auto"/>

                <!-- 문자열입력 공간-->
                <ColumnDefinition Width="*"/>

                <!-- 오른쪽 아이콘 -->
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- 좌측 아이콘 -->
              <ctrls:HeimdallrIcon
                        Grid.Column="0"
                        Width="{TemplateBinding IconSize}"
                        Height="{TemplateBinding IconSize}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        PathIcon="{TemplateBinding PathIcon}"
                        Fill="{TemplateBinding Fill}"/>

              <!-- 텍스트 입력란 -->
              <TextBox x:Name="PART_TextBox"
                        Grid.Column="1"
                        Margin="5 0 0 0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{TemplateBinding Foreground}"
                        CaretBrush="{TemplateBinding CaretBrush}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        TextAlignment="{TemplateBinding TextAlignment}"
                       
                        Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"

                        FontSize="{TemplateBinding FontSize}"
                        FontFamily="{TemplateBinding FontFamily}"
                        FontWeight="{TemplateBinding FontWeight}"
                        IsEnabled="{TemplateBinding IsEnabled}"

                        IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrRightIconTextBox}}"
                        AcceptsTab="{Binding AcceptsTab, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrRightIconTextBox}}"
                        MaxLength="{Binding MaxLength, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrRightIconTextBox}}"
                        CharacterCasing="{Binding CharacterCasing, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrRightIconTextBox}}"
                        TextWrapping="{Binding TextWrapping, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrRightIconTextBox}}"
                        AcceptsReturn="{Binding AcceptsReturn, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrRightIconTextBox}}"

                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"

                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />     

              <!-- 플레이스홀더 텍스트 -->
              <TextBlock x:Name="PlaceholderTextBlock"
                         Text="{TemplateBinding Placeholder}"
                         Foreground="{TemplateBinding PlaceholderForeground}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left"
                         Margin="10,0,0,0"
                         IsHitTestVisible="False"
                         Visibility="Collapsed"
                         Grid.Column="1"/>

              <!-- Entity 클래스의 디스플레이의 Description 값 가져오기-->
              <TextBlock x:Name="PART_TextBlock"
                         Foreground="{TemplateBinding PlaceholderForeground}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left"
                         Padding="3"
                         Margin="10,0,0,0"
                         IsHitTestVisible="False"
                         Visibility="Collapsed"
                         Grid.Column="1"/>

              <!-- 오른쪽 아이콘 버튼(설명가져오기) -->
              <Button x:Name="PART_RightButton"
                      Grid.Column="2"
                      Width="{TemplateBinding Width}" 
                      Height="{TemplateBinding Height}"
                      Background="Transparent"
                      BorderThickness="0"
                      Content="{Binding RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrRightIconTextBox}, Path=RightPathIcon}">

                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <ctrls:HeimdallrIcon x:Name="PART_RightIcon"
                                        Width="{Binding IconSizeRigth, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrRightIconTextBox}}" 
                                        Height="{Binding IconSizeRigth, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrRightIconTextBox}}"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        ToolTip="DESCRIPTION"
                                        PathIcon="{Binding RightPathIcon, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrRightIconTextBox}}"
                                        Fill="{Binding RightFill, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrRightIconTextBox}}"/>

                    <ControlTemplate.Triggers>
                      <!-- 마우스 오버 시 -->
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="PART_RightIcon" Property="Fill"
                            Value="{Binding Fill, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrRightIconTextBox}}"/>
                      </Trigger>

                      <!-- 클릭 시 -->
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="PART_RightIcon" Property="Fill"
                            Value="{Binding RightPressedFill, RelativeSource={RelativeSource AncestorType=ctrls:HeimdallrRightIconTextBox}}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>

            </Grid>
          </Border>

          <!-- 트리거 정의: 마우스 오버, 포커스, 입력 여부 -->
          <ControlTemplate.Triggers>

            <!-- 마우스 올리면 BorderBrush 색상 변경 -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="textBorder" Property="BorderBrush" 
                      Value="{Binding Fill, RelativeSource={RelativeSource TemplatedParent}}"/>
            </Trigger>

            <!-- 키보드 포커스 시 Border 강조 -->
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="textBorder" Property="BorderBrush" 
                      Value="{Binding RightPressedFill, RelativeSource={RelativeSource TemplatedParent}}"/>
              <Setter TargetName="textBorder" Property="BorderThickness" Value="0.5 0.5 0.5 2"/>
            </Trigger>

            <!-- 텍스트 없을 때 플레이스홀더 표시 -->
            <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="">
              <Setter TargetName="PlaceholderTextBlock" Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>