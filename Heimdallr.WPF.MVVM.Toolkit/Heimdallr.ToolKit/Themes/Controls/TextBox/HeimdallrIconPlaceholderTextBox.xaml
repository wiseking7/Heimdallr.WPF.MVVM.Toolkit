<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
                    xmlns:ctrls="clr-namespace:Heimdallr.ToolKit.UI.Controls">

  <Style TargetType="{x:Type ctrls:HeimdallrIconPlaceholderTextBox}">
    <Setter Property="Padding" Value="5" />
    <Setter Property="Background" Value="White" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ctrls:HeimdallrIconPlaceholderTextBox}">
          <Border x:Name="textBorder"
                  CornerRadius="5"
                  BorderThickness="2"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  Background="{TemplateBinding Background}">
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- 좌측 아이콘 -->
              <ctrls:HeimdallrIcon
                  Grid.Column="0"
                  Width="25" Height="25"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  PathIcon="{TemplateBinding PathIcon}"
                  Fill="{TemplateBinding Fill}" />

              <!-- 텍스트 입력 -->
              <TextBox x:Name="PART_TextBox"
                       Grid.Column="1"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="{TemplateBinding Foreground}"
                       CaretBrush="{TemplateBinding CaretBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Stretch"
                       Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

              <!-- 플레이스홀더 텍스트 -->
              <TextBlock x:Name="PlaceholderTextBlock"
                         Text="{TemplateBinding Placeholder}"
                         Foreground="{TemplateBinding PlaceholderForeground}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left"
                         Margin="5,0,0,0"
                         IsHitTestVisible="False"
                         Visibility="Collapsed"
                         Grid.Column="1"/>
            </Grid>
          </Border>

          <ControlTemplate.Triggers>
            <!-- 마우스 오버 시 테두리 강조 -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="textBorder" Property="BorderBrush" Value="#FFF58F84"/>
            </Trigger>

            <!-- 포커스 시 강조 -->
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="textBorder" Property="BorderBrush" Value="#FFF58F84"/>
              <Setter TargetName="textBorder" Property="BorderThickness" Value="0.5 0.5 0.5 3"/>
            </Trigger>

            <!-- 텍스트 없을 때 플레이스홀더 표시 -->
            <DataTrigger Binding="{Binding Text, ElementName=PART_TextBox}" Value="">
              <Setter TargetName="PlaceholderTextBlock" Property="Visibility" Value="Visible"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>